<Window x:Class="MathZone.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MathZone" Height="780" Width="1280" MinHeight="650" MinWidth="1000"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#151821" Padding="18">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="2,8,0,28">
      <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentBrush}">
       <TextBlock Text="M" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
       <TextBlock Text="MathZone" FontSize="21" FontWeight="Bold"/>
       <TextBlock Text="GAME CENTER" FontSize="9" Foreground="#9BA3B7"/>
      </StackPanel>
     </StackPanel>
     <Button Content="⌂   Hjem" HorizontalContentAlignment="Left" Background="#393064" Click="Home_Click"/>
     <Button Content="▦   Spillbutikk" HorizontalContentAlignment="Left" Click="Store_Click"/>
     <Button Content="▣   Bibliotek" HorizontalContentAlignment="Left" Click="Library_Click"/>
     <Button Content="⇩   Nedlastinger" HorizontalContentAlignment="Left" Click="Downloads_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
     <TextBlock Text="MATHZONE PREVIEW" Foreground="#838BA0" FontSize="10" Margin="5,0,0,8"/>
     <TextBlock Text="Dette er en startpakke. Butikken bruker demo-spill til du legger til ekte spillkilder." TextWrapping="Wrap" Foreground="#9BA3B7" FontSize="11" Margin="5,0,5,10"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="26">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,0,0,22">
    <TextBox x:Name="SearchBox" Width="300" Height="38" FontSize="14" Padding="12,8" Background="#202531" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Søk etter spill"/>
    <TextBlock Text="●  Klar til spilling" Foreground="#7EE0B2" VerticalAlignment="Center" Margin="18,0,0,0"/>
    <TextBlock Text="M  Spiller" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
   </DockPanel>
   <Border Grid.Row="1" CornerRadius="18" Padding="28" Margin="0,0,0,22">
    <Border.Background>
     <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#302A66" Offset="0"/>
      <GradientStop Color="#1B3554" Offset="0.55"/>
      <GradientStop Color="#222631" Offset="1"/>
     </LinearGradientBrush>
    </Border.Background>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="DIN NESTE SPILLØKT STARTER HER" Foreground="#C7C2FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
      <TextBlock Text="Velkommen til MathZone" FontSize="32" FontWeight="Bold" Margin="0,0,0,10"/>
      <TextBlock Text="Én launcher. Spillene dine. Ditt bibliotek." FontSize="16" Foreground="#D3D7E5" Margin="0,0,0,18"/>
      <StackPanel Orientation="Horizontal">
       <Button Content="Åpne biblioteket  →" Background="{StaticResource AccentBrush}" Click="Library_Click"/>
       <Button Content="Utforsk butikken" Click="Store_Click"/>
      </StackPanel>
     </StackPanel>
     <Viewbox Grid.Column="1" Stretch="Uniform" Margin="15">
      <Grid Width="210" Height="150">
       <Ellipse Width="130" Height="130" Fill="#4B42A5" Opacity=".35"/>
       <TextBlock Text="MZ" FontSize="74" FontWeight="Black" Foreground="#E8E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Border Width="56" Height="56" CornerRadius="18" Background="#9B8CFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,5,0" RenderTransformOrigin=".5,.5">
        <Border.RenderTransform><RotateTransform Angle="12"/></Border.RenderTransform>
        <TextBlock Text="✦" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
      </Grid>
     </Viewbox>
    </Grid>
   </Border>
   <Grid Grid.Row="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
     <TextBlock x:Name="SectionTitle" Text="Anbefalt for deg" FontSize="22" FontWeight="Bold"/>
     <TextBlock x:Name="CountLabel" Text="6 spill" Foreground="#9BA3B7" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </DockPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
     <ItemsControl x:Name="GamesList">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border Width="218" Background="{StaticResource PanelBrush}" CornerRadius="13" Margin="0,0,14,14" Padding="12">
         <StackPanel>
          <Border Height="112" CornerRadius="9" Background="{Binding Color}">
           <Grid>
            <TextBlock Text="{Binding Symbol}" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border Background="#66000000" CornerRadius="5" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
             <TextBlock Text="{Binding Tag}" FontSize="9" FontWeight="Bold"/>
            </Border>
           </Grid>
          </Border>
          <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Margin="2,12,0,3"/>
          <TextBlock Text="{Binding Description}" Foreground="#AAB1C2" FontSize="11" TextWrapping="Wrap" Height="32"/>
          <DockPanel Margin="0,9,0,0">
           <TextBlock Text="{Binding Price}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
           <Button Content="{Binding Action}" DockPanel.Dock="Right" Padding="12,7" Click="GameAction_Click" Tag="{Binding Name}"/>
          </DockPanel>
         </StackPanel>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </Grid>
   <TextBlock Grid.Row="3" Text="MathZone • Uoffisiell launcher-demo • Ingen tilknytning til Epic Games" Foreground="#727B90" FontSize="10" Margin="0,12,0,0"/>
  </Grid>
 </Grid>
</Window>
